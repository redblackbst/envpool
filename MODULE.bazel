module(
    name = "envpool",
    # Adjust the version if you wish.
    version = "0.0.1",
    repo_name = "envpool",
)

# Core Bazel registry deps
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
bazel_dep(name = "rules_qt", version = "0.0.5")
bazel_dep(name = "rules_boost", repo_name = "com_github_nelhage_rules_boost")

# Declare and configure the Python toolchain
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(
    python_version = "3.12",
    python_version_env = "BAZEL_PYTHON_VERSION",
)

# Declare the versions for which to build wheels
python.toolchain(python_version = "3.12")
python.toolchain(python_version = "3.13")
python.toolchain(python_version = "3.14")
use_repo(python, "python_3_12", "python_3_13", "python_3_14")

# Load CUDA module extension and use it
cuda_configure = use_repo_rule("//third_party/cuda:cuda.bzl", "cuda_configure")

cuda_configure(name = "cuda")

# Parse and install your pip packages
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip_requirements",
    python_version = "3.12",
    requirements_by_platform = {
        "//third_party/pip_requirements:requirements-stoix.txt": "linux_x86_64",
    },
)
pip.parse(
    hub_name = "pip_requirements",
    python_version = "3.13",
    requirements_by_platform = {
        "//third_party/pip_requirements:requirements-stoix.txt": "linux_x86_64",
    },
)
pip.parse(
    hub_name = "pip_requirements",
    python_version = "3.14",
    requirements_by_platform = {
        "//third_party/pip_requirements:requirements-stoix.txt": "linux_x86_64,linux_x86_64_freethreaded",
    },
)

# Actually create the repos for these pip dependencies
use_repo(pip, "pip_requirements")

# Prefer the prebuilt cmake/ninja toolchains and the locally installed GNU
# autotools/pkg-config instead of building them from source.
register_toolchains(
    "@rules_foreign_cc//toolchains:preinstalled_cmake_toolchain",
    "@rules_foreign_cc//toolchains:built_ninja_toolchain",
    "@rules_foreign_cc//toolchains:preinstalled_make_toolchain",
    "@rules_foreign_cc//toolchains:preinstalled_pkgconfig_toolchain",
    "@rules_foreign_cc//toolchains:preinstalled_autoconf_toolchain",
    "@rules_foreign_cc//toolchains:preinstalled_automake_toolchain",
    "@rules_foreign_cc//toolchains:preinstalled_m4_toolchain",
)

# Qt setup (fetched Qt6 with unsuffixed alias repo @qt)
qt_ext = use_extension("@rules_qt//extension:qt.bzl", "fetch")
qt_ext.install(
    name = "qt6",
    build_file = "@rules_qt//extension:qt/6.8.3/linux_x86_64.BUILD",
    os = "linux",
    version = "6.8.3",
)
use_repo(qt_ext, "qt6")

# Provide @qt alias repo pointing at qt6 targets.
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")
new_local_repository(
    name = "qt",
    path = ".",
    build_file_content = """
alias(name = "qt_core", actual = "@qt6//:qt_core_linux", visibility = ["//visibility:public"])
alias(name = "qt_gui", actual = "@qt6//:qt_gui_linux", visibility = ["//visibility:public"])
""",
)
register_toolchains("@rules_qt//tools:all")

# Use custom pybind11_bazel
bazel_dep(name = "pybind11_bazel", version = "3.0.0+redblackbst.0")
git_override(
    module_name = "pybind11_bazel",
    commit = "f5a8361ff025538572878b0a932799ac274546b4",
    remote = "https://github.com/redblackbst/pybind11_bazel.git",
)

# rules_boost overrides and non-module repos
archive_override(
    module_name = "rules_boost",
    integrity = "sha256-LTilyiMMjpYyAi1PW+8RycyAEHy9clo7915R0Bchb2E=",
    strip_prefix = "rules_boost-master",
    urls = ["https://github.com/nelhage/rules_boost/archive/refs/heads/master.tar.gz"],
)

non_module_boost_repositories = use_extension("@com_github_nelhage_rules_boost//:boost/repositories.bzl", "non_module_dependencies")
use_repo(
    non_module_boost_repositories,
    "boost",
)

